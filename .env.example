# Copy this file to .env and adjust values as needed.

# Base URL of the Indexia Finance backend API (no trailing slash needed).
VITE_API_BASE_URL=https://new-finance-back.onrender.com/api

# Public site URL — used for canonical URLs, Open Graph tags and the sitemap.
VITE_SITE_URL=https://indexiafinance.com

# ── Email OTP (server-side only: api/email-otp/* and the Vite dev server) ─────
# Any SMTP provider works. Leave SMTP_HOST empty to disable email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Indexia Finance <no-reply@indexiafinance.com>"

# Signs each emailed code. Set a long random value in production;
# SMTP_PASS is used as a fallback when this is empty.
EMAIL_OTP_SECRET=

# Mailbox that receives careers applications (defaults to hr@indexiafinance.com).
CAREERS_EMAIL=hr@indexiafinance.com
